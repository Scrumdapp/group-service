#
# Scrumdapp readme, these are all the values needed for the app to launch
#

#
# Database credentials
#

# The database driver to use, postgres recomended
DATABASE_DRIVER=org.postgresql.Driver

APPLICATION_PORT=3000

# Other database data...
DATABASE_URL=jdbc:postgresql://localhost:5432/scrumdapp
DATABASE_USER=scrumdapp
DATABASE_PASSWORD=scrumdapp

JWK_SET_URI=http://localhost:9999/.well-known/jwks.json
USER_SERVICE_URL=http://localhost:3000
USER_FETCH_ENDPOINT=/users
# If using vite you must use 'vite preview --host 127.0.0.1' to prevent IO error's
PICTURE_BACKGROUND_CHECK_ENDPOINT=http://localhost:4173/backgrounds/

INVITE_SERVICE_URL=http://localhost:3000